<div class="grid" data-layout="50-50">
  <dl>
    <div>
      <dt>Date :</dt>
      <dd><%= training_session.date %></dd>
    </div>
    <div>
      <dt>Lieu :</dt>
      <dd><%= training_session.location %></dd>
    </div>
    <div>
      <dt>Ville :</dt>
      <dd><%= training_session.city %></dd>
    </div>
    <div>
      <dt>Invité :</dt>
      <dd><%= training_session.guest %></dd>
    </div>
    <div>
      <dt>Status :</dt>
      <dd><%= training_session.status %></dd>
    </div>
    <div>
      <dt>Couverture :</dt>
      <dd><%= image_tag training_session.image if training_session.image.present? %></dd>
    </div>
    <div>
      <dt>Notes :</dt>
      <dd><%= training_session.comment %></dd>
    </div>
  </dl>
  <dl>
    <dt>Description :</dt>
    <dd>
      <div class="editor-content-wrapper">
        <%= training_session.formatted_content %>
      </div>
    </dd>
  </dl>
</div>
<div class="students flow">
  <h3>Liste des inscrits au rendez-vous</h3>
  <%= form_for training_training_session_path, html: {
      method: "put",
      data: { turbo_frame: "subscriptions" }, class: "cluster"
    } do |f| %>
    <%= turbo_frame_tag "student", class: "cluster" do %>
      <%= text_field :student, :name, list: "student-list", placeholder: "Rechercher un élève existant", required: true %>
      <datalist id="student-list">
        <% @students.each do |student| %>
          <option value="<%= student.name %>"><%= student.name %></option>
        <% end %>
      </datalist>
      <%= f.button class: "button" do %>Ajouter un élève existant<% end %>
    <% end %>
  <% end %>
  <%= turbo_frame_tag "student-list" do %>
    <table class="training-student-list item-list">
      <thead>
        <tr>
          <th class="cell-name">Nom</th>
          <th class="cell-email">Email</th>
          <th class="cell-phone">Téléphone</th>
          <th class="cell-comment">Notes</th>
          <th class="cell-options">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% training_session.students.each do |student| %>
          <%= render "trainings/training_sessions/student", student: student %>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
<%= link_to "Supprimer ce rendez-vous",
  training_training_session_path(training_id: @training.id, id: training_session.id),
  class: "button",
  data: {
    "button-variant": "alert",
    turbo_method: :delete,
    turbo_confirm: "Êtes-vous sûr·e de vouloir supprimer ce rendez-vous ?"
  } %>