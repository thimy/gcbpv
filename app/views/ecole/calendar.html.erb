<% content_for(:page_class, "ecole calendar ") %>
<% content_for(:page_title, "Calendrier de l’école") %>

<section class="flow">
  <%= image_tag "ecole/calendrier-2627.jpg" %>
  <% if @events.present? %>
    <%= render Website::Card::Event::Component.with_collection(@events, inline: true) %>
  <% else %>
    <div class="panel">
      Aucun événement à venir
    </div>
  <% end %>
  <h3>Les interventions externes</h3>

  <%= link_to "https://padlet.com/gcbpvemt/ou-jouer-dans-le-pays-ecole-de-musique-trad-2026-2027-8e3v6ysndnip2dxq" do %>Découvrez les différents événements où va intervenir l'EMT<% end %>
</section>
