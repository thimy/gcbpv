<%- headers = [
  "Nom",
  "Prénom",
  "Montant des inscriptions",
  "Communauté de communes",
  "Pourcentage de réduction",
  "Coût après réduction",
  "Montant des cotisations",
  "Dons",
  "Locations",
  "Coût total",
  "Montant payé",
  "Montant restant"] -%>
<%= CSV.generate_line headers %>
<%- @filtered_households.includes(:subscription_groups).where(subscription_groups: {status: [1, 2]}).order("last_name").each do |household| -%>
  <%= CSV.generate_line([
    household.last_name,
    household.first_name,
    household.subscription_group(@season).subscription_cost,
    household.subscription_group(@season).majoration_class,
    household.subscription_group(@season).discount_percentage,
    household.subscription_group(@season).subscription_cost_after_discount,
    household.subscription_group(@season).plan.membership_price,
    household.subscription_group(@season).donation,
    household.subscription_group(@season).loan_cost,
    household.subscription_group(@season).total_cost,
    household.subscription_group(@season).total_paid,
    household.subscription_group(@season).total_remaining
    ]) -%>
<%- end -%>
