<turbo-frame id="subscription-form">
  <div class="repel">
    <div>
      <dl>
        <div>
          <dt>Consentement à l’image :</dt>
          <dd>
            <%= show_status_emojis(@subscription.image_consent) %>
          </dd>
        </div>
        <div>
          <dt>Situation empêchée :</dt>
          <dd>
            <%= show_status_emojis(@subscription.disability) %>
          </dd>
        </div>
        <div>
          <dt>ARS :</dt>
          <dd>
            <%= show_status_emojis(@subscription.ars) %>
          </dd>
        </div>
      </dl>
      <dl>
        <div>
          <dt>Statut de l'inscription :</dt>
          <dd><%= subscription.status %></dd>
        </div>
          <div>
            <dt>Location d’instrument :</dt>
            <dd><%= [subscription.loan&.instrument.presence, number_to_currency(subscription.loan&.cost.presence, unit: "€")].compact.join(" · ") %></dd>
          </div>
          <div>
            <dt>Notes de location :</dt>
            <dd><%= subscription.loan&.comment %></dd>
          </div>
      </dl>
      <dl>
        <div>
          <dt>Notes sur l'inscription en cours :</dt>
          <dd><%= subscription.comment %></dd>
        </div>
      </dl>
    </div>
    <%= link_to subscription_edit_subscription_path(subscription_id: subscription.id), class: "button", "data-button-size": "small" do %>
      <%= inline_svg "icons/edit" %>
    <% end %>
  </div>
</turbo-frame>
