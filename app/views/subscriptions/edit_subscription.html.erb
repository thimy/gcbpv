<%= turbo_frame_tag "subscription-form" do %>
  <%= form_for @subscription, url: subscription_update_path, method: "patch", html: {class: "inline repel"} do |form| %>
    <div class="flow">
      <div class="cluster">
        <%= label_tag :household, "Transférer l’inscription vers un autre foyer :" %>
        <%= text_field :household, :name, list: "household-list", placeholder: "Rechercher un payeur existant" %>
        <datalist id="household-list">
          <% @households.each do |household| %>
            <option value="<%= household.name %>"><%= household.name %></option>
          <% end %>
        </datalist>
      </div>
      <div class="flow">
        <div class="flow">
          <label>Consentement à l'image</label>
          <div class="cluster">
            <div class="cluster">
              <%= form.radio_button :image_consent, 1, {checked: @subscription.image_consent.present?} %>
              <%= form.label :image_consent_1, "Oui" %>
            </div>
            <div class="flow">
              <%= form.radio_button :image_consent, 0, {checked: @subscription.image_consent == false} %>
              <%= form.label :image_consent_0, "Non" %>
            </div>
          </div>
        </div>
        <div class="flow">
          <label>Situation empêchée</label>
          <div class="cluster">
            <div class="cluster">
              <%= form.radio_button :disability, 1, {checked: @subscription.disability.present?} %>
              <%= form.label :disability_1, "Oui" %>
            </div>
            <div class="cluster">
              <%= form.radio_button :disability, 0, {checked: @subscription.disability == false} %>
              <%= form.label :disability_0, "Non" %>
            </div>
          </div>
        </div>
        <div class="flow">
          <label>ARS</label>
          <div class="cluster">
            <div class="cluster">
              <%= form.radio_button :ars, 1, {checked: @subscription.ars.present?} %>
              <%= form.label :ars_1, "Oui" %>
            </div>
            <div class="cluster">
              <%= form.radio_button :ars, 0, {checked: @subscription.ars == false} %>
              <%= form.label :ars_0, "Non" %>
            </div>
          </div>
        </div>
      </div>
      <div class="cluster">
        <%= form.label :status, "Statut de l’inscription :" %>
        <%= form.select :status, options_for_select(Subscription.statuses.keys.to_a, selected: @subscription.present? ? @subscription.status : 0) %>
      </div>
      <div class="cluster">
        <%= form.label :comment, "Notes sur l’inscription en cours :" %>
        <%= form.text_area :comment, rows: 1 %>
      </div>
      <%= form.fields_for :loan, @subscription.loan || Loan.new do |loan_form| %>
        <div class="cluster">
          <%= loan_form.label :instrument, "Location d’instrument :" %>
          <%= loan_form.text_field :instrument %>
        </div>
        <div class="cluster">
          <%= loan_form.label :cost, "Montant :" %>
          <%= loan_form.text_field :cost %>
        </div>
        <div class="cluster">
          <%= loan_form.label :comment, "Notes sur la location :" %>
          <%= loan_form.text_field :comment %>
        </div>
      <% end %>
    </div>
    <div class="cluster">
      <button type="submit" class="button" data-button-size="small">
        <%= inline_svg "icons/check" %>
      </button>
      <%= link_to subscription_show_subscription_path(subscription_id: @subscription.id), class: "button", "data-button-size": "small" do %>
        <%= inline_svg "icons/cross" %>
      <% end %>
    </div>
  <% end %>
<% end %>
