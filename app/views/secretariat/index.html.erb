<% @seasons.each do |season| %>
  <h2>Année <%= season.name %></h2>
  <div class="grid">
    <%= link_to subscriptions_url(season: season), class: "card panel" do %>
      <div class="card-info">
        <h3>Nombre d’inscriptions</h3>
        <div><%= season.active_subscription_size %></div>
      </div>
    <% end %>
    <%= link_to "#{subscriptions_url(season: season)}?status=1", class: "card panel" do %>
      <div class="card-info">
        <h3>Élèves confirmés</h3>
        <div><%= season.confirmed_subscription_size %></div>
      </div>
    <% end %>
    <%= link_to "#{subscriptions_url(season: season)}?status=0", class: "card panel" do %>
      <div class="card-info">
        <h3>Demandes d’information</h3>
        <div><%= season.unconfirmed_subscription_size %></div>
      </div>
    <% end %>
    <%= link_to "#{subscriptions_url(season: season)}?status=2", class: "card panel" do %>
      <div class="card-info">
        <h3>Inscriptions annulées</h3>
        <div><%= season.canceled_subscriptions_size %></div>
      </div>
    <% end %>
    <div class="card panel">
      <div class="card-info">
        <h3>Nombre d'élèves en atelier adulte</h3>
        <div><%= season.adult_count %></div>
      </div>
    </div>
    <div class="card panel">
      <div class="card-info">
        <h3>Nombre d'élèves en atelier enfance (tous confondus)</h3>
        <div><%= season.kid_count %></div>
      </div>
    </div>
    <div class="card panel">
      <div class="card-info">
        <h3>Nombre d'élèves en éveil musical</h3>
        <div><%= season.get_workshop_count(63) %></div>
      </div>
    </div>
    <div class="card panel">
      <div class="card-info">
        <h3>Nombre d'élèves en découverte instrumentale</h3>
        <div><%= season.get_workshop_count(62) %></div>
      </div>
    </div>
  </div>
<% end %>
