<turbo-frame id="subscription-summary">
  <div class="flow">
    <h2>Inscriptions</h2>
    <%= render Shared::Table::Component.new do |table| %>
      <% table.with_header do |header| %>
        <% header.with_column(name: "student") do %>Élève<% end %>
        <% header.with_column(name: "type") do %>Cours/atelier<% end %>
        <% header.with_column(name: "day_of_week") do %>Jour<% end %>
        <% header.with_column(name: "city") do %>Ville<% end %>
        <% header.with_column(name: "option") do %>Optionel<% end %>
        <% header.with_column(name: "comment") do %>Notes<% end %>
        <% header.with_column(name: "amount") do %>Prix (tarif <%= @subscription_group.majoration_class %>)<% end %>
      <% end %>
      <% if subscription_group&.subscriptions.present? %>
        <% subscription_group&.subscriptions.each do |subscription| %>
          <% subscription.items.each_with_index do |item, index| %>
            <% if item[:course].present? %>
              <% table.with_row do |row| %>
                <% if index == 0 %>
                  <% row.with_cell(name: "student", class: "nowrap", rowspan: get_subscription_row_count(subscription)) do %><%= link_to subscription.student.name, student_url(season: @season, record: subscription.student), "data-turbo": false %><% end %>
                <% end %>
                <% row.with_cell(name: "type", class: "nowrap") do %><%= item[:course].instrument.name %><% end %>
                <% row.with_cell(name: "day_of_week") do %><%= item[:course].slot.day_of_week %><% end %>
                <% row.with_cell(name: "city") do %><%= item[:course].slot.city.name %><% end %>
                <% row.with_cell(name: "option", class: "nowrap") do %><%= item[:course].option %><% end %>
                <% row.with_cell(name: "comment") do %><%= item[:course].comment %><% end %>
                <% row.with_cell(name: "amount", rowspan: get_row_count(item)) do %>
                  <%= number_to_currency(item[:price], unit: "€") || "À définir" %>
                <% end %>
              <% end %>
            <% end %>
            <% if item[:workshops].present? %>
              <% item[:workshops].each_with_index do |workshop, w_index| %>
                <% table.with_row do |row| %>
                  <% if index == 0 && w_index == 0 && !item[:course].present? %>
                    <% row.with_cell(name: "student", class: "nowrap", rowspan: get_subscription_row_count(subscription)) do %><%= link_to subscription.student.name, student_url(season: @season, record: subscription.student), "data-turbo": false %><% end %>
                  <% end %>
                  <% row.with_cell(name: "type", class: "nowrap") do %><%= workshop.workshop.name %><% end %>
                  <% row.with_cell(name: "day_of_week") do %><%= workshop.workshop_slot.day_of_week %><% end %>
                  <% row.with_cell(name: "city") do %><%= workshop.workshop_slot.city.name %><% end %>
                  <% row.with_cell(name: "option", class: "nowrap") do %><%= workshop.option %><% end %>
                  <% row.with_cell(name: "comment") do %><%= workshop.comment %><% end %>
                  <% if w_index == 0 && !item[:course].present? %>
                    <% row.with_cell(name: "amount", rowspan: get_row_count(item)) do %>
                      <%= number_to_currency(item[:price], unit: "€") || "À définir" %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
            <% if item[:kid_workshop].present? %>
              <% table.with_row do |row| %>
                <% row.with_cell(name: "student", class: "nowrap", rowspan: get_subscription_row_count(subscription)) do %><%= link_to subscription.student.name, subscription_path(subscription), "data-turbo": false %><% end %>
                <% row.with_cell(name: "type", class: "nowrap") do %><%= item[:kid_workshop].workshop.name %><% end %>
                <% row.with_cell(name: "day_of_week") do %><%= item[:kid_workshop].workshop_slot.day_of_week %><% end %>
                <% row.with_cell(name: "city") do %><%= item[:kid_workshop].workshop_slot.city.name %><% end %>
                <% row.with_cell(name: "option", class: "nowrap") do %><%= item[:kid_workshop].option %><% end %>
                <% row.with_cell(name: "comment") do %><%= item[:kid_workshop].comment %><% end %>
                <% row.with_cell(name: "amount") do %>
                  <%= number_to_currency(item[:price], unit: "€") || "À définir" %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <% table.with_row(class: "strong") do |row| %>
        <% row.with_cell(name: "course_cost", colspan: 6) do %>Sous-total des inscriptions<% end %>
        <% row.with_cell(name: "amount") do %><%= number_to_currency(@subscription_group.subscription_cost, unit: "€") %><% end %>
      <% end %>
      <% unless @subscription_group.discount_percentage.to_i == 0 %>
        <% table.with_row do |row| %>
          <% row.with_cell(name: "discount", colspan: 6) do %>
            <%= "Remise (-#{@subscription_group.discount_percentage.to_i}%)" %><% end %>
          <% row.with_cell(name: "amount") do %>-<%= number_to_currency(@subscription_group.subscriptions_discount, unit: "€") %><% end %>
        <% end %>
      <% end %>
      <% table.with_row do |row| %>
        <% row.with_cell(name: "extra_discount", colspan: 6) do %>
          <%= "Remise exceptionnelle" %>
        <% end %>
        <% row.with_cell(name: "amount") do %>
          <%= render "subscription_groups/discount", subscription_group: @subscription_group %>
        <% end %>
      <% end %>
      <% table.with_row(class: "strong") do |row| %>
        <% row.with_cell(name: "total", colspan: 6) do %>Sous-total après remise<% end %>
        <% row.with_cell(name: "amount") do %><%= number_to_currency(@subscription_group.subscription_cost_after_discount, unit: "€") %><% end %>
      <% end %>
      <% subscription_group&.subscriptions.each do |subscription| %>
        <% if subscription.loan.present? %>
          <% table.with_row do |row| %>
            <% row.with_cell(name: "loan", class: "nowrap", colspan: 5) do %><%= "Location d’instrument pour #{subscription.student.name} : #{subscription.loan.instrument}" %><% end %>
            <% row.with_cell(name: "loan-comment") do %><%= subscription.loan.comment %><% end %>
            <% row.with_cell(name: "amount") do %><%= number_to_currency(subscription.loan.cost, unit: "€") %><% end %>
          <% end %>
        <% end %>
      <% end %>
      <% table.with_row do |row| %>
        <% row.with_cell(name: "membership", colspan: 6) do %>Adhésion au Groupement Culturel Breton des Pays de Vilaine<% end %>
        <% row.with_cell(name: "amount") do %>+<%= number_to_currency(@subscription_group.season.plan.membership_price, unit: "€") %><% end %>
      <% end %>
      <% table.with_row do |row| %>
        <% row.with_cell(name: "donation", colspan: 6) do %>Don<% end %>
        <% row.with_cell(name: "amount") do %>
          <%= render "subscription_groups/donation", subscription_group: @subscription_group %>
        <% end %>
      <% end %>
      <% table.with_footer do |footer| %>
        <% footer.with_cell(name: "final_total", colspan: 6) do %>Montant total<% end %>
        <% footer.with_cell(name: "amount") do %>
          <%= number_to_currency(@subscription_group.total_cost, unit: "€") %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
